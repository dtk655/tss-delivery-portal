# Read-only Token-Based Authentication for NetSuite SuiteQL.
# Leave these blank to run the October 23 sample board.
# In Netlify: Site configuration → Environment variables → add each name.
# Scope them to Functions. Never commit real values. .env is gitignored.

NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
