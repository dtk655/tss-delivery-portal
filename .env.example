# Copy to .env.local for local work. On Netlify, set these in Site configuration > Environment variables.

# Sign-in (required on Netlify; the site won't let anyone in until both are set)
APP_PASSWORD=tss-dispatch
AUTH_SECRET=replace-with-a-long-random-string

# NetSuite orders: the Grok bot posts to /api/data-upload with header x-upload-secret
DATA_UPLOAD_SECRET=replace-with-a-long-random-string

# Fleetio live truck GPS (Fleetio > Account > API keys)
FLEETIO_API_KEY=
FLEETIO_ACCOUNT_TOKEN=

# Driver route texts (same Twilio number as the lane closure portal works)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email for customer delivery notices and the company route email (Outlook / Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TSS Deliveries <deliveries@trafficsafetyservice.com>"
MAIL_REPLY_TO=
COMPANY_ROUTES_TO=

# Evening auto-dispatch (texts 5:00 PM, company email 5:30 PM, weekdays)
ENABLE_AUTO_DISPATCH=false
CRON_SECRET=replace-with-a-long-random-string

# Yard location for the map (defaults to central NJ)
YARD_LAT=
YARD_LON=
